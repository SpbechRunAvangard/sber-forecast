<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Forecast_v2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sber-forecast" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_org" name="Организаторы хакатона: ТЗ, данные, скоринг" />
    <bpmn:participant id="P_main" name="Команда «Авангард»: итоговый процесс решения sber-forecast" processRef="Process_Main" />
    <bpmn:messageFlow id="m1" name="ТЗ (ред. 25.10), sales, stock" sourceRef="P_org" targetRef="Start" />
    <bpmn:messageFlow id="m2" name="Архив и презентация" sourceRef="End_docs" targetRef="P_org" />
    <bpmn:messageFlow id="m3" name="Git-репозиторий ★" sourceRef="End_star" targetRef="P_org" />
    <bpmn:textAnnotation id="A_1"><bpmn:text>Ориентир score на 4 периодах: v6 — 0,785, первая версия — 0,807, простое правило — 0,816. Ожидаемый ранговый score на лидерборде ≈ 0,17 (3-е место).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as_A_1" sourceRef="G_q" targetRef="A_1" />
    <bpmn:textAnnotation id="A_2"><bpmn:text>Риск: на сезонных неделях прогноз даёт 81% фактического объёма (до обнуления 94%). Август — пик.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as_A_2" sourceRef="M_season" targetRef="A_2" />
    <bpmn:textAnnotation id="A_3"><bpmn:text>Ориентир score — min-max к «последнему значению» с весами ТЗ (меньше — лучше). Жюри использует ранговую нормировку, поэтому это ориентир, а не итоговый балл.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as_A_3" sourceRef="M_base" targetRef="A_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="Итоговый процесс прогноза" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L0" name="Данные: очистка и сетка (Елена)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1" name="Аналитика: EDA, сегменты, остатки">
        <bpmn:flowNodeRef>A_eda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_conc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="ML: модель, валидация, прогноз (Никита)">
        <bpmn:flowNodeRef>M_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_feat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_thr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_season</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_art</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Документация и бизнес">
        <bpmn:flowNodeRef>D_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_zip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="★ Контейнер: Docker + FastAPI">
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_star</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Получены ТЗ (ред. 25.10) и данные">
      <bpmn:outgoing>f_Start_T_load</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_load" name="Загрузить sales и stock, отрезать всё после 26.07.2026">
      <bpmn:documentation>По ТЗ от 25.10 для обучения и признаков разрешены данные только по 2026-07-26 включительно. sales_sum и discount_sum переводятся из np.log через np.exp перед суммированием; в признаки идут только отношения.</bpmn:documentation>
      <bpmn:incoming>f_Start_T_load</bpmn:incoming>
      <bpmn:outgoing>f_T_load_T_clean</bpmn:outgoing>
      <bpmn:property id="prop_DO_raw" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="dia_DO_raw"><bpmn:sourceRef>DO_raw_ref</bpmn:sourceRef><bpmn:targetRef>prop_DO_raw</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T_clean" name="Продажи — сумма по департаментам; остатки — сумма всех дублей, минус = резерв">
      <bpmn:documentation>stock — остаток на начало дня. Все строки с одинаковыми date × склад × артикул складываются (6,15 млн → 4,88 млн ключей), отрицательные значения допустимы.</bpmn:documentation>
      <bpmn:incoming>f_T_load_T_clean</bpmn:incoming>
      <bpmn:outgoing>f_T_clean_T_grid</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_grid" name="Сетка 11 × 799 по дням: нет продаж → 0, нет остатка → NaN">
      <bpmn:documentation>8 789 рядов, 13.12.2023 — 26.07.2026. Недели прогноза начинаются с понедельника.</bpmn:documentation>
      <bpmn:incoming>f_T_clean_T_grid</bpmn:incoming>
      <bpmn:outgoing>f_T_grid_A_eda</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DS_grid"><bpmn:targetRef>DS_grid_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_eda" name="EDA и сегментация ABC/XYZ: ходовые, сезонные, редкие">
      <bpmn:documentation>Ходовые 8,6% рядов / 57% объёма; сезонные 2,1% / 4%; редкие 89% / 39%; 40 рядов без продаж. Август — пик в горизонте прогноза.</bpmn:documentation>
      <bpmn:incoming>f_T_grid_A_eda</bpmn:incoming>
      <bpmn:outgoing>f_A_eda_A_stock</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DO_seg"><bpmn:targetRef>DO_seg_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_stock" name="Остатки: ~63% дней без продаж — остаток на начало дня ≤ 0">
      <bpmn:documentation>Среди дней без продаж с известным остатком в 63,4% остаток на начало дня ≤ 0. По 47% таких дней остаток неизвестен; 30% объёма продано при остатке ≤ 0 (резерв).</bpmn:documentation>
      <bpmn:incoming>f_A_eda_A_stock</bpmn:incoming>
      <bpmn:outgoing>f_A_stock_A_conc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_conc" name="Вывод: остаток — признак модели, а не жёсткое правило «нет товара → 0»">
      <bpmn:incoming>f_A_stock_A_conc</bpmn:incoming>
      <bpmn:outgoing>f_A_conc_M_base</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_base" name="Метрики score.py, простые прогнозы, 4 периода проверки по 9 недель">
      <bpmn:documentation>Недели с 25.05, 23.03, 19.01.2026 и сезонные 28.07.2025. Простое правило (среднее за 13 недель): 0,816 в среднем.</bpmn:documentation>
      <bpmn:incoming>f_A_conc_M_base</bpmn:incoming>
      <bpmn:outgoing>f_M_base_M_feat</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_feat" name="≈80 признаков: ряд, недели, прошлый год, артикул по всем складам, цена и скидка, остатки">
      <bpmn:documentation>Базовые 22 признака ряда + недельные и сезонные + уровень артикула по всем складам, склада, категории×склада, относительная цена и доля скидки, динамика остатков.</bpmn:documentation>
      <bpmn:incoming>f_M_base_M_feat</bpmn:incoming>
      <bpmn:incoming>f_G_q_M_feat</bpmn:incoming>
      <bpmn:outgoing>f_M_feat_M_train</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_train" name="Две модели LightGBM Tweedie (22 и все признаки): среднее × сезон^0,5 × 0,9">
      <bpmn:documentation>Цель — средние недельные продажи за 9 недель; сезон — продажи тех же недель год назад к уровню 90 дней до них. Округление до целых.</bpmn:documentation>
      <bpmn:incoming>f_M_feat_M_train</bpmn:incoming>
      <bpmn:outgoing>f_M_train_M_thr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_thr" name="Решение «0 или уровень»: модель ожидаемого выигрыша SMAPE">
      <bpmn:documentation>Третья модель LightGBM оценивает SMAPE(0) − SMAPE(уровень). Ненулевой прогноз, если выигрыш &gt; 0 и уровень ≥ 0,5. SMAPE 134,6 → 59,4.</bpmn:documentation>
      <bpmn:incoming>f_M_train_M_thr</bpmn:incoming>
      <bpmn:outgoing>f_M_thr_M_season</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_season" name="Сезонный период 28.07–22.09.2025 — те же недели годом раньше">
      <bpmn:documentation>Прогноз / факт объёма: 0,94 до обнуления, 0,81 после → в пик объём занижен.</bpmn:documentation>
      <bpmn:incoming>f_M_thr_M_season</bpmn:incoming>
      <bpmn:outgoing>f_M_season_G_q</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_q" name="Лучше простого правила?">
      <bpmn:incoming>f_M_season_G_q</bpmn:incoming>
      <bpmn:outgoing>f_G_q_M_final</bpmn:outgoing>
      <bpmn:outgoing>f_G_q_M_feat</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_final" name="Финальное обучение по 26.07: три модели, детерминированно">
      <bpmn:documentation>896 тыс. строк обучения; повторный запуск даёт тот же файл.</bpmn:documentation>
      <bpmn:incoming>f_G_q_M_final</bpmn:incoming>
      <bpmn:incoming>f_G_v_M_final</bpmn:incoming>
      <bpmn:outgoing>f_M_final_M_sub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_sub" name="Submission: 9 недель с 27.07.2026, 79 101 строка, целые числа">
      <bpmn:documentation>week — понедельник; без NaN и отрицательных; 223,4 тыс. шт. — 1,05 от предыдущих 9 недель; 56% рядов — 0.</bpmn:documentation>
      <bpmn:incoming>f_M_final_M_sub</bpmn:incoming>
      <bpmn:outgoing>f_M_sub_G_v</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DO_sub"><bpmn:targetRef>DO_sub_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_v" name="Формат верный, результат повторяется?">
      <bpmn:incoming>f_M_sub_G_v</bpmn:incoming>
      <bpmn:outgoing>f_G_v_M_art</bpmn:outgoing>
      <bpmn:outgoing>f_G_v_M_final</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_art" name="weekly_model_v6.py: из сырых CSV тот же submission">
      <bpmn:documentation>Сверка с экспериментом: расхождение 0 по всем трём моделям.</bpmn:documentation>
      <bpmn:incoming>f_G_v_M_art</bpmn:incoming>
      <bpmn:outgoing>f_M_art_PG</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DO_model"><bpmn:targetRef>DO_model_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="PG">
      <bpmn:incoming>f_M_art_PG</bpmn:incoming>
      <bpmn:outgoing>f_PG_D_desc</bpmn:outgoing>
      <bpmn:outgoing>f_PG_K1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="D_desc" name="Описание решения для архива">
      <bpmn:incoming>f_PG_D_desc</bpmn:incoming>
      <bpmn:outgoing>f_D_desc_D_pres</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DO_doc"><bpmn:targetRef>DO_doc_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="D_pres" name="Презентация: v6, проверка, лидерборд, риск августа">
      <bpmn:incoming>f_D_desc_D_pres</bpmn:incoming>
      <bpmn:outgoing>f_D_pres_D_zip</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_DO_pres"><bpmn:targetRef>DO_pres_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="D_zip" name="Собрать архив: код, описание, submission.csv">
      <bpmn:incoming>f_D_pres_D_zip</bpmn:incoming>
      <bpmn:outgoing>f_D_zip_End_docs</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_docs" name="Архив и презентация отправлены">
      <bpmn:incoming>f_D_zip_End_docs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="K1" name="src/data_pipeline.py: сетка из сырых sales и stock">
      <bpmn:incoming>f_PG_K1</bpmn:incoming>
      <bpmn:outgoing>f_K1_K2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="K2" name="app/: POST/GET /predict, /predict/all; отрицательный stock допустим">
      <bpmn:documentation>Прогноз API — 9 недель с понедельника после недели последней даты sales. 422 — история &lt; 180 дней или quantity &lt; 0; 400 — пустой файл или GET без параметров.</bpmn:documentation>
      <bpmn:incoming>f_K1_K2</bpmn:incoming>
      <bpmn:outgoing>f_K2_K3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="K3" name="Dockerfile, README, тесты: прогноз контейнера = submission">
      <bpmn:incoming>f_K2_K3</bpmn:incoming>
      <bpmn:outgoing>f_K3_End_star</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_star" name="Репозиторий с контейнером передан">
      <bpmn:incoming>f_K3_End_star</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_Start_T_load" sourceRef="Start" targetRef="T_load" />
    <bpmn:sequenceFlow id="f_T_load_T_clean" sourceRef="T_load" targetRef="T_clean" />
    <bpmn:sequenceFlow id="f_T_clean_T_grid" sourceRef="T_clean" targetRef="T_grid" />
    <bpmn:sequenceFlow id="f_T_grid_A_eda" sourceRef="T_grid" targetRef="A_eda" />
    <bpmn:sequenceFlow id="f_A_eda_A_stock" sourceRef="A_eda" targetRef="A_stock" />
    <bpmn:sequenceFlow id="f_A_stock_A_conc" sourceRef="A_stock" targetRef="A_conc" />
    <bpmn:sequenceFlow id="f_A_conc_M_base" sourceRef="A_conc" targetRef="M_base" />
    <bpmn:sequenceFlow id="f_M_base_M_feat" sourceRef="M_base" targetRef="M_feat" />
    <bpmn:sequenceFlow id="f_M_feat_M_train" sourceRef="M_feat" targetRef="M_train" />
    <bpmn:sequenceFlow id="f_M_train_M_thr" sourceRef="M_train" targetRef="M_thr" />
    <bpmn:sequenceFlow id="f_M_thr_M_season" sourceRef="M_thr" targetRef="M_season" />
    <bpmn:sequenceFlow id="f_M_season_G_q" sourceRef="M_season" targetRef="G_q" />
    <bpmn:sequenceFlow id="f_G_q_M_final" name="да" sourceRef="G_q" targetRef="M_final" />
    <bpmn:sequenceFlow id="f_G_q_M_feat" name="нет" sourceRef="G_q" targetRef="M_feat" />
    <bpmn:sequenceFlow id="f_M_final_M_sub" sourceRef="M_final" targetRef="M_sub" />
    <bpmn:sequenceFlow id="f_M_sub_G_v" sourceRef="M_sub" targetRef="G_v" />
    <bpmn:sequenceFlow id="f_G_v_M_art" name="да" sourceRef="G_v" targetRef="M_art" />
    <bpmn:sequenceFlow id="f_G_v_M_final" name="нет" sourceRef="G_v" targetRef="M_final" />
    <bpmn:sequenceFlow id="f_M_art_PG" sourceRef="M_art" targetRef="PG" />
    <bpmn:sequenceFlow id="f_PG_D_desc" sourceRef="PG" targetRef="D_desc" />
    <bpmn:sequenceFlow id="f_PG_K1" sourceRef="PG" targetRef="K1" />
    <bpmn:sequenceFlow id="f_D_desc_D_pres" sourceRef="D_desc" targetRef="D_pres" />
    <bpmn:sequenceFlow id="f_D_pres_D_zip" sourceRef="D_pres" targetRef="D_zip" />
    <bpmn:sequenceFlow id="f_D_zip_End_docs" sourceRef="D_zip" targetRef="End_docs" />
    <bpmn:sequenceFlow id="f_K1_K2" sourceRef="K1" targetRef="K2" />
    <bpmn:sequenceFlow id="f_K2_K3" sourceRef="K2" targetRef="K3" />
    <bpmn:sequenceFlow id="f_K3_End_star" sourceRef="K3" targetRef="End_star" />
    <bpmn:dataObjectReference id="DO_raw_ref" name="sales.csv, stock.csv" dataObjectRef="DO_raw" />
    <bpmn:dataObject id="DO_raw" />
    <bpmn:dataStoreReference id="DS_grid_ref" name="base_grid_clean.csv" dataStoreRef="DS_grid" />
    <bpmn:dataObjectReference id="DO_seg_ref" name="series_segments.csv, дашборд" dataObjectRef="DO_seg" />
    <bpmn:dataObject id="DO_seg" />
    <bpmn:dataObjectReference id="DO_model_ref" name="weekly_model_v6.py, model_v6_*.txt" dataObjectRef="DO_model" />
    <bpmn:dataObject id="DO_model" />
    <bpmn:dataObjectReference id="DO_sub_ref" name="submission_weekly_v6.csv" dataObjectRef="DO_sub" />
    <bpmn:dataObject id="DO_sub" />
    <bpmn:dataObjectReference id="DO_doc_ref" name="Описание решения" dataObjectRef="DO_doc" />
    <bpmn:dataObject id="DO_doc" />
    <bpmn:dataObjectReference id="DO_pres_ref" name="Презентация" dataObjectRef="DO_pres" />
    <bpmn:dataObject id="DO_pres" />
  </bpmn:process>
  <bpmn:dataStore id="DS_grid" name="base_grid_clean.csv" />
  <bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
    <bpmndi:BPMNShape id="P_org_di" bpmnElement="P_org" isHorizontal="true"><dc:Bounds x="160" y="30" width="4745" height="90" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_main_di" bpmnElement="P_main" isHorizontal="true"><dc:Bounds x="160" y="170" width="4745" height="1200" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L0_di" bpmnElement="L0" isHorizontal="true" bioc:fill="#e3f2fd" color:background-color="#e3f2fd"><dc:Bounds x="190" y="170" width="4715" height="240" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true" bioc:fill="#e8f5e9" color:background-color="#e8f5e9"><dc:Bounds x="190" y="410" width="4715" height="240" /></bpmndi:BPMNShape>
