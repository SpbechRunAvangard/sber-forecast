<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Forecast" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_main" name="Прогноз продаж: склад × артикул, 64 дня — сквозной пайплайн решения" processRef="Process_Main" />
    <bpmn:participant id="P_org" name="Организаторы хакатона (ТЗ, данные, автоскоринг score.py)" />
    <bpmn:messageFlow id="m1" name="ТЗ + sales_dataset_hakaton.csv + stock_dataset_hakaton.csv" sourceRef="P_org" targetRef="Start" />
    <bpmn:messageFlow id="m2" name="Архив (код + описание + submission.csv) и презентация" sourceRef="End_docs" targetRef="P_org" />
    <bpmn:messageFlow id="m3" name="Git-репозиторий (★)" sourceRef="End_star" targetRef="P_org" />
    <bpmn:textAnnotation id="A1">
      <bpmn:text>ABC: A≈80% / B≈15% / C≈5% накопленного объёма. XYZ: CV недельных продаж, пороги подбираем по данным. Прерывистый спрос: ADI ≥ 1.32 (Syntetos–Boylan).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_A1" sourceRef="S1" targetRef="A1" />
    <bpmn:textAnnotation id="A2">
      <bpmn:text>В тесте будущие остатки неизвестны → в модель идут только лаги и последний известный stock (без утечки).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_A2" sourceRef="XOR_om" targetRef="A2" />
    <bpmn:textAnnotation id="A3">
      <bpmn:text>SMAPE (50%) считается по каждой серии с равным весом: для редких рядов ошибка «0 против &gt; 0» = 200%, поэтому решение «0 или &gt; 0» критично. Итог — ранговая нормализация.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_A3" sourceRef="EVAL" targetRef="A3" />
    <bpmn:textAnnotation id="A4">
      <bpmn:text>Состав: 11 складов × 799 артикулов × 64 дня = 562 496 строк; даты подряд; без NaN и отрицательных; прогноз детерминирован.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_A4" sourceRef="POST" targetRef="A4" />
    <bpmn:group id="G_eda" categoryValueRef="CV_G_eda" />
    <bpmn:group id="G_seg" categoryValueRef="CV_G_seg" />
    <bpmn:group id="G_stock" categoryValueRef="CV_G_stock" />
    <bpmn:group id="G_mod" categoryValueRef="CV_G_mod" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_panel" name="Панельный датасет" />
  <bpmn:process id="Process_Main" name="Пайплайн прогноза продаж" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L5" name="★ DevOps (опционально): Docker + FastAPI">
        <bpmn:flowNodeRef>XOR_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_star</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="Документация и бизнес: описание решения, презентация">
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PGj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="ML-инженер: признаки, модели, прогноз, submission">
        <bpmn:flowNodeRef>FE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_BASE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_H</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BLEND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EVAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FINAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_v</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Аналитик: влияние остатков (stock)">
        <bpmn:flowNodeRef>O1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_o</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_om</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1" name="Аналитик: EDA и сегментация рядов">
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ABC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XYZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEG_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEG_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEG_H</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CROSS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L0" name="Данные: загрузка, очистка, агрегация">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_agg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Получены ТЗ и датасеты">
      <bpmn:documentation>Старт: организаторы передали ТЗ хакатона и два CSV (sales_dataset_hakaton.csv, stock_dataset_hakaton.csv). Задача: прогноз quantity по паре «склад × артикул» на 64 дня вперёд от последней даты обучающей выборки.</bpmn:documentation>
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_load" name="Загрузить два CSV: продажи (sales) и остатки (stock)">
      <bpmn:documentation>sales: date, composite_division, cities_name, warehouse_name, category_lvl_1..3, article, characteristic, quantity, sales_sum, cost_price, discount_sum, volume_weight. stock: date, warehouse_name, char_article (= article), stock.</bpmn:documentation>
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
      <bpmn:property id="Property_17gt313" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="da1">
        <bpmn:sourceRef>DO_sales_ref</bpmn:sourceRef>
        <bpmn:targetRef>Property_17gt313</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="da2">
        <bpmn:sourceRef>DO_stock_ref</bpmn:sourceRef>
        <bpmn:targetRef>Property_17gt313</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T_clean" name="Проверить и очистить: типы, даты, дубли, NaN, отрицательные значения, article ↔ char_article">
      <bpmn:documentation>Контроль качества: формат дат YYYY-MM-DD, дубликаты строк, пропуски, отрицательные quantity/stock, совпадение справочника article и char_article, список из 11 складов и 799 артикулов.</bpmn:documentation>
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_agg" name="Агрегировать до date × склад × артикул (сумма по департаментам), достроить сетку, пропуски = 0">
      <bpmn:documentation>Согласно ТЗ все composite_division суммируются в рамках пары «склад — товар». Полная сетка дат × 11 складов × 799 артикулов; отсутствие строки = нулевые продажи. Дополнительно агрегируются sales_sum, discount_sum (сумма), cost_price (среднее/медиана), volume_weight.</bpmn:documentation>
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_join" name="Присоединить остатки: (date, склад, article = char_article); пропуски stock — флаг">
      <bpmn:documentation>Левое соединение панели продаж с остатками. Пропуск stock не заполняется молча: заводится флаг «остаток неизвестен».</bpmn:documentation>
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f05</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da3">
        <bpmn:targetRef>DS_panel_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="PG0">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="E1" name="EDA (время): динамика, тренд, сезонность неделя / месяц / год, выбросы, доля нулевых дней">
      <bpmn:documentation>Агрегированные ряды по дням/неделям/месяцам, STL-декомпозиция, автокорреляция на лагах 7/30/365, поиск выбросов и пропущенных периодов, доля нулевых дней по сериям.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_eda</bpmn:categoryValueRef>
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="E2" name="EDA (срезы): склады, города, категории lvl 1–3, департаменты, цена, скидка, объёмный вес">
      <bpmn:documentation>Сравнение складов и городов, структура категорий lvl1–3, вклад департаментов, связь quantity с ценой (cost_price), скидкой (discount_sum), объёмным весом.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_eda</bpmn:categoryValueRef>
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S1" name="Метрики рядов: объём, средний спрос, ADI, CV², CV недельных продаж, сила сезонности">
      <bpmn:documentation>Для каждой из 11×799 серий: суммарный объём и выручка, средний спрос, ADI (средний интервал между продажами), CV² ненулевых размеров, CV недельных продаж, сила сезонности по STL.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PG1">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11_ABC</bpmn:outgoing>
      <bpmn:outgoing>f11_XYZ</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="ABC" name="ABC-анализ: вклад серии в объём и выручку (A ≈ 80%, B ≈ 15%, C ≈ 5%)">
      <bpmn:documentation>Ранжирование серий по убыванию вклада в quantity (и sales_sum), накопленная доля: A — первые ~80%, B — следующие ~15%, C — оставшиеся ~5%. Границы настраиваются.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f11_ABC</bpmn:incoming>
      <bpmn:outgoing>f12_ABC</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XYZ" name="XYZ-анализ: коэффициент вариации спроса (X — стабильный, Y — колеблющийся, Z — нерегулярный)">
      <bpmn:documentation>CV = σ/μ по недельным (при необходимости дневным) продажам серии. Пороги X/Y/Z подбираются по фактическому распределению CV: классические 10%/25% рассчитаны на месячные данные.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f11_XYZ</bpmn:incoming>
      <bpmn:outgoing>f12_XYZ</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PG2">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f12_ABC</bpmn:incoming>
      <bpmn:incoming>f12_XYZ</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="XOR1" name="Редкий ряд? (ADI ≥ 1.32 или мало продаж / короткая история)" default="f15">
      <bpmn:documentation>Порог ADI ≥ 1.32 — классическое разделение прерывистого спроса по Syntetos–Boylan. Дополнительно можно учитывать долю нулевых дней и длину истории.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="XOR2" name="Выраженная сезонность?" default="f17">
      <bpmn:documentation>Критерий: сила сезонности (STL) выше порога и/или значимая автокорреляция на сезонных лагах (7, 30, 365 дней).</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SEG_R" name="Сегмент РЕДКИЕ (прерывистый спрос)">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f18_SEG_R</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SEG_S" name="Сегмент СЕЗОННЫЕ (выраженная сезонность)">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18_SEG_S</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SEG_H" name="Сегмент ХОДОВЫЕ (стабильный регулярный спрос)">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18_SEG_H</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR3">
      <bpmn:categoryValueRef>CV_G_seg</bpmn:categoryValueRef>
      <bpmn:incoming>f18_SEG_R</bpmn:incoming>
      <bpmn:incoming>f18_SEG_S</bpmn:incoming>
      <bpmn:incoming>f18_SEG_H</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="FIX" name="Зафиксировать сегменты: матрица ABC × XYZ × тип ряда, доля серий и вклад в объём">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da4">
        <bpmn:targetRef>DO_seg_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="PG3">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="CROSS" name="Кросс-анализ: доля OOS и эффект остатков по сегментам (ABC/XYZ, тип ряда)">
      <bpmn:documentation>Сводит результаты ветки остатков с сегментацией: какая доля дней без остатка приходится на ходовые / редкие / сезонные ряды и классы ABC/XYZ.</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CONC" name="Выводы для модели: признаки, стратегия по сегментам, таргет, валидация, риски">
      <bpmn:documentation>Итог EDA: перечень признаков, выбор подхода по каждому сегменту, трансформация таргета (log1p), схема валидации, обработка нулей и редких рядов, ограничения (нет будущих остатков).</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da5">
        <bpmn:targetRef>DO_conc_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="PG4">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="O1" name="Выявить дни без остатка (stock = 0 / низкий), доля OOS по складам и товарам">
      <bpmn:documentation>Дни OOS: stock = 0 и низкий остаток (порог — доля от среднего суточного спроса). Доли OOS по складам, артикулам, категориям.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O2" name="Сравнить продажи при stock = 0 и &#62; 0; корреляция stock ↔ quantity (лаги)">
      <bpmn:documentation>Эффект «нет товара — нет продаж»: средние продажи при stock=0 и stock&gt;0, корреляция quantity с лагами stock, поведение спроса до и после пополнения.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_o" name="Остатки значимо влияют на продажи?" default="f27">
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O3" name="Да: признаки stock (лаги, rolling, дни с OOS, флаг OOS), коррекция цензурированного спроса">
      <bpmn:documentation>Признаки по остаткам строятся только из прошлых значений. В дни OOS наблюдаемые продажи занижены (цензурированный спрос) — их можно помечать флагом или исключать/корректировать при обучении.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f28_O3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O4" name="Нет: остаток — слабый признак или не используется">
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28_O4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_om">
      <bpmn:categoryValueRef>CV_G_stock</bpmn:categoryValueRef>
      <bpmn:incoming>f28_O3</bpmn:incoming>
      <bpmn:incoming>f28_O4</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="FE" name="Признаки: календарь, лаги / rolling, дни без продаж, stock, цена / скидка, категории, сегмент">
      <bpmn:documentation>Календарные (день недели, месяц, день года, праздники — только из открытого календаря, закрытые внешние данные запрещены), лаги и rolling-статистики (7–56 дней), доля нулей, дни с последней продажи, признаки stock, цена/скидка, категории lvl1–3, склад, город, сегмент ABC/XYZ/тип ряда.</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="VAL" name="Схема валидации: time-split, holdout 64 дня (как на тесте)">
      <bpmn:documentation>Валидация по времени без перемешивания: последние 64 дня как отложенная выборка, при возможности несколько скользящих окон. Метрики считаются так же, как в score.py.</bpmn:documentation>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PG5">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34_M_BASE</bpmn:outgoing>
      <bpmn:outgoing>f34_M_H</bpmn:outgoing>
      <bpmn:outgoing>f34_M_R</bpmn:outgoing>
      <bpmn:outgoing>f34_M_S</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="M_BASE" name="Baseline: последнее известное значение (наивный прогноз)">
      <bpmn:documentation>Бейзлайн организаторов — прогноз последним известным значением; нужен для сравнения и как резервный вариант.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_mod</bpmn:categoryValueRef>
      <bpmn:incoming>f34_M_BASE</bpmn:incoming>
      <bpmn:outgoing>f35_M_BASE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_H" name="ХОДОВЫЕ: глобальный GBM (LightGBM / CatBoost), таргет log1p">
      <bpmn:documentation>Рекомендация (уточнить под фактическое решение команды): один глобальный градиентный бустинг по ходовым сериям, учитывает RMSE/WAPE на крупных объёмах.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_mod</bpmn:categoryValueRef>
      <bpmn:incoming>f34_M_H</bpmn:incoming>
      <bpmn:outgoing>f35_M_H</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_R" name="РЕДКИЕ: Croston / TSB или GBM (Tweedie), порог обнуления">
      <bpmn:documentation>Рекомендация: методы для прерывистого спроса или GBM с Tweedie/Poisson; для SMAPE критично решение «0 или &gt; 0» (ошибка 200%).</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_mod</bpmn:categoryValueRef>
      <bpmn:incoming>f34_M_R</bpmn:incoming>
      <bpmn:outgoing>f35_M_R</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_S" name="СЕЗОННЫЕ: GBM с сезонными признаками / seasonal naive / ETS">
      <bpmn:documentation>Рекомендация: сезонные признаки и лаги на длинной истории; Prophet/ETS/seasonal naive как альтернатива.</bpmn:documentation>
      <bpmn:categoryValueRef>CV_G_mod</bpmn:categoryValueRef>
      <bpmn:incoming>f34_M_S</bpmn:incoming>
      <bpmn:outgoing>f35_M_S</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PG6">
      <bpmn:incoming>f35_M_BASE</bpmn:incoming>
      <bpmn:incoming>f35_M_H</bpmn:incoming>
      <bpmn:incoming>f35_M_R</bpmn:incoming>
      <bpmn:incoming>f35_M_S</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="BLEND" name="Ансамбль по сегментам + калибровка bias">
      <bpmn:documentation>Блендинг / стекинг моделей и сегментная калибровка масштаба прогноза, чтобы снизить |Bias| (10% веса).</bpmn:documentation>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="EVAL" name="Метрики на валидации: SMAPE 50%, WAPE 20%, RMSE 15%, |Bias| 10%, RMSLE 5%">
      <bpmn:documentation>Расчёт пяти метрик ТЗ в целом и в разрезе сегментов (ходовые / редкие / сезонные, ABC/XYZ). Итоговая оценка организаторов — ранговая нормализация.</bpmn:documentation>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_q" name="Лучше baseline, метрики приемлемы?" default="f39">
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="PG8">
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
      <bpmn:outgoing>f42</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="FINAL" name="Переобучить на всей истории (фиксированный seed) и спрогнозировать 64 дня">
      <bpmn:documentation>Финальное обучение и прогноз ежедневно на 64 календарных дня от последней даты. Детерминированность: фиксированные seed, версии библиотек, порядок данных.</bpmn:documentation>
      <bpmn:incoming>f41</bpmn:incoming>
      <bpmn:outgoing>f43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PG10">
      <bpmn:incoming>f43</bpmn:incoming>
