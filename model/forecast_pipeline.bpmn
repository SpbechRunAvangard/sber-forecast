      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR_v" name="Формат корректен, результат воспроизводим?" default="f47">
      <bpmn:incoming>f46</bpmn:incoming>
      <bpmn:outgoing>f47</bpmn:outgoing>
      <bpmn:outgoing>f48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="D1" name="Бизнес-часть (черновик): проблема, ценность, находки EDA, сегменты, влияние остатков">
      <bpmn:documentation>Проблема: прогноз спроса по 11 складам × 799 артикулам на 64 дня. Ценность: меньше дефицита и излишков. Находки: сегментация ABC/XYZ (ходовые / редкие / сезонные), доля потерь из-за OOS.</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f49</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="PGj">
      <bpmn:incoming>f42</bpmn:incoming>
      <bpmn:incoming>f49</bpmn:incoming>
      <bpmn:outgoing>f50</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="D3" name="Дополнить бизнес-часть: метрики, эффект, рекомендации по запасам и OOS">
      <bpmn:documentation>Результаты модели простым языком: качество по сегментам, где прогноз надёжен, где нет, рекомендации по управлению запасами для A/B/C и X/Y/Z.</bpmn:documentation>
      <bpmn:incoming>f50</bpmn:incoming>
      <bpmn:outgoing>f51</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da7">
