      <bpmn:outgoing>f45</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="POST" name="Постобработка, сборка submission (562 496 строк), проверка формата и повторного запуска">
      <bpmn:documentation>clip ≥ 0, NaN → 0, ровно 64 подряд идущие даты, все 11 × 799 пар, колонки date, warehouse_name, article, quantity. Повторный запуск должен давать идентичный файл.</bpmn:documentation>
      <bpmn:incoming>f44</bpmn:incoming>
      <bpmn:incoming>f47</bpmn:incoming>
      <bpmn:outgoing>f46</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da6">
